{% if days is empty %}
    <p class="text-muted mb-0">{{ __('No day left from this import.', 'feriae') }}</p>
{% else %}
    <table class="table table-sm table-hover mb-0">
        <thead>
            <tr>
                <th>{{ __('Date') }}</th>
                <th>{{ __('Name') }}</th>
                <th>{{ 'Entity'|itemtype_name }}</th>
                <th>{{ 'Calendar'|itemtype_name(2) }}</th>
            </tr>
        </thead>
        <tbody>
            {% for day in days %}
                <tr>
                    <td class="text-nowrap">{{ day.holiday_date|formatted_date }}</td>
                    <td>
                        {% if day.name is not null %}
                            {{ get_item_link('Holiday', day.holidays_id) }}
                            {% if day.is_perpetual %}
                                <span class="badge bg-blue-lt ms-1">{{ __('Recurrent') }}</span>
                            {% endif %}
                            {% if day.is_moved %}
                                <span class="badge bg-secondary-lt ms-1" title="{{ __('Transferred to another entity since the import: left alone, like a close time entered by hand', 'feriae') }}">{{ __('Moved', 'feriae') }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">{{ day.holiday_key }}</span>
                            <span class="badge bg-secondary-lt ms-1">{{ __('Deleted by hand', 'feriae') }}</span>
                        {% endif %}
                    </td>
                    <td>{{ day.entities_id is not null ? get_item_name('Entity', day.entities_id) : '' }}</td>
                    <td>{{ day.name is not null ? day.calendars : '' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

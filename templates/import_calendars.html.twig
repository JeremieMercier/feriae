{% if calendars is empty %}
    <p class="text-muted mb-0">{{ __('The close times of this import are not attached to any calendar.', 'feriae') }}</p>
{% else %}
    <table class="table table-sm table-hover mb-0">
        <thead>
            <tr>
                <th>{{ 'Calendar'|itemtype_name }}</th>
                <th>{{ 'Entity'|itemtype_name }}</th>
                <th>{{ __('Close times of this import', 'feriae') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for calendar in calendars %}
                <tr>
                    <td>{{ get_item_link('Calendar', calendar.id) }}</td>
                    <td>{{ get_item_name('Entity', calendar.entities_id) }}</td>
                    <td>{{ calendar.holidays }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
